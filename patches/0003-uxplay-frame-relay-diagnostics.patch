+// C diagnostics ABI for the custom macOS AVSampleBufferDisplayLayer sink.
+//
+// The hot path remains inside avsample_sink.m.  The renderer only receives a
+// value snapshot once per diagnostic reporting interval; no Core Media or
+// Objective-C types cross this boundary.
+
+#ifndef AVSAMPLE_SINK_H
+#define AVSAMPLE_SINK_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct AVLayerSinkDiagnostics {
+    uint64_t ready_rejects;
+    uint64_t invalid_inputs;
+    uint64_t layer_failed_flushes;
+    uint64_t pixel_buffer_create_count;
+    uint64_t pixel_buffer_create_failures;
+    uint64_t pixel_buffer_create_ns_total;
+    uint64_t pixel_buffer_create_ns_max;
+    uint64_t lock_failures;
+    uint64_t copy_count;
+    uint64_t copy_ns_total;
+    uint64_t copy_ns_max;
+    uint64_t format_count;
+    uint64_t format_failures;
+    uint64_t format_ns_total;
+    uint64_t format_ns_max;
+    uint64_t sample_count;
+    uint64_t sample_failures;
+    uint64_t sample_ns_total;
+    uint64_t sample_ns_max;
+    uint64_t enqueue_count;
+    uint64_t resume_recovery_count;
+    uint64_t resume_recovery_ns_total;
+    uint64_t resume_recovery_ns_max;
+} AVLayerSinkDiagnostics;
+
+void *avlayer_sink_create(void *nsview_ptr);
+int   avlayer_sink_enqueue_nv12(void *sink, const unsigned char *y, unsigned long y_stride,
+                                const unsigned char *uv, unsigned long uv_stride,
+                                int width, int height, uint64_t pts_ns, uint64_t duration_ns);
+void  avlayer_sink_flush(void *sink);
+void  avlayer_sink_pause(void *sink);
+void  avlayer_sink_resume(void *sink);
+void  avlayer_sink_get_diagnostics(void *sink, AVLayerSinkDiagnostics *out);
+void  avlayer_sink_destroy(void *sink);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
