+static uint64_t diagnostic_object_property_u64(GObject *object, const char *name) {
+    if (!object) return 0;
+    GParamSpec *spec = g_object_class_find_property(G_OBJECT_GET_CLASS(object), name);
+    if (!spec) return 0;
+    GValue value = G_VALUE_INIT;
+    g_value_init(&value, G_PARAM_SPEC_VALUE_TYPE(spec));
+    g_object_get_property(object, name, &value);
+    uint64_t result = 0;
+    if (G_VALUE_HOLDS_UINT64(&value)) {
+        result = g_value_get_uint64(&value);
+    } else if (G_VALUE_HOLDS_UINT(&value)) {
+        result = g_value_get_uint(&value);
+    } else if (G_VALUE_HOLDS_ULONG(&value)) {
+        result = g_value_get_ulong(&value);
+    } else if (G_VALUE_HOLDS_INT64(&value)) {
+        gint64 signed_value = g_value_get_int64(&value);
+        result = signed_value > 0 ? (uint64_t)signed_value : 0;
+    } else if (G_VALUE_HOLDS_INT(&value)) {
+        gint signed_value = g_value_get_int(&value);
+        result = signed_value > 0 ? (uint64_t)signed_value : 0;
+    } else if (G_VALUE_HOLDS_LONG(&value)) {
+        glong signed_value = g_value_get_long(&value);
+        result = signed_value > 0 ? (uint64_t)signed_value : 0;
+    }
+    g_value_unset(&value);
+    return result;
+}
