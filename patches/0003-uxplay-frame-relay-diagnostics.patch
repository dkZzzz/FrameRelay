+static void diagnostic_atomic_max(_Atomic uint64_t *target, uint64_t value) {
+    uint64_t previous = atomic_load_explicit(target, memory_order_relaxed);
+    while (previous < value &&
+           !atomic_compare_exchange_weak_explicit(target, &previous, value,
+                                                  memory_order_relaxed,
+                                                  memory_order_relaxed)) {
+        // `previous` is refreshed by compare_exchange_weak on failure.
+    }
+}
