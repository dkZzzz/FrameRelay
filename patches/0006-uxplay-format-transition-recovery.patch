+/// Clear the image and queued samples after a live video-format transition,
+/// such as the iPhone changing from the portrait lock screen back to a
+/// landscape game.  Unlike avlayer_sink_flush(), this deliberately preserves
+/// the running media timebase: the stream did not pause, only its pixel
+/// dimensions/orientation changed.
+void avlayer_sink_flush_image(void *sink_) {
+    AVLayerSink *s = (AVLayerSink *)sink_;
+    if (!s) return;
+    atomic_fetch_add_explicit(&s->format_flushes, 1, memory_order_relaxed);
+    void *layer_ref = atomic_load_explicit(&s->layer, memory_order_acquire);
+    if (!layer_ref) return;
+    AVSampleBufferDisplayLayer *layer = (__bridge AVSampleBufferDisplayLayer *)layer_ref;
+    [layer flushAndRemoveImage];
+    // Arm the permit after the flush, so a sample racing with the flush cannot
+    // consume the permit and then get removed by the flush itself.  The next
+    // sample is the one that seeds the new format.
+    atomic_store_explicit(&s->resume_seed_pending, true, memory_order_release);
+}
+
 /// Pause the presentation clock as well as removing the old image. Keeping the
 /// timebase stopped prevents a phone lock interval from making the first
 /// post-unlock timestamp look stale.
@@ -404,6 +425,7 @@ void avlayer_sink_get_diagnostics(void *sink_, AVLayerSinkDiagnostics *out) {
     AV_COPY_DIAG(ready_rejects);
     AV_COPY_DIAG(invalid_inputs);
     AV_COPY_DIAG(layer_failed_flushes);
+    AV_COPY_DIAG(format_flushes);
     AV_COPY_DIAG(pixel_buffer_create_count);
     AV_COPY_DIAG(pixel_buffer_create_failures);
     AV_COPY_DIAG(pixel_buffer_create_ns_total);
